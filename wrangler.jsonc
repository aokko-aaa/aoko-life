{
  // Worker の名前。名刺に印刷したURL（life.aokoworks.workers.dev）と直結しているので変更しないこと
  "name": "life",
  "compatibility_date": "2025-09-01",

  // 公開するのは public フォルダの中身だけ（ページのファイルだけの形。管理画面から手動で公開していたときと同じ）
  // 以前の自作フォーム用の仕組み（src/worker.js）は、今は使っていないので公開しない
  "assets": {
    // 公開するフォルダ。この中のファイルがそのままサイトになる
    "directory": "./public"
  },

  // 動かなかったときに、原因をCloudflareの画面で見られるようにする
  "observability": {
    "enabled": true
  }
}
